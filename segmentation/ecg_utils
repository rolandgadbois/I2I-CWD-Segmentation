                plt.close()


        AllRPeaks = []
        AllRPeaks = np.concatenate([RPeaksMartinez, RPeaksNeurokit, RPeaksPromac, RPeaksRodrigues])
        Methods = np.concatenate([np.full(len(RPeaksMartinez), 1), np.full(len(RPeaksNeurokit), 2), np.full(len(RPeaksPromac), 3), np.full(len(RPeaksRodrigues), 4)])

        AvailableMethods = set()
        if len(RPeaksMartinez) > 0: AvailableMethods.add(1)
        if len(RPeaksNeurokit) > 0: AvailableMethods.add(2)
        if len(RPeaksPromac) > 0: AvailableMethods.add(3)
        if len(RPeaksRodrigues) > 0: AvailableMethods.add(4)

